---
/**
 * Model page gallery: angle thumbnails, the large 3:4 photo (or its print
 * preview) with previous / next, the counter and the «Zoom» button.
 *
 * Lies inside the page's `[data-gallery]` root (ModelProduct.astro), which
 * also holds the colour swatches. Clicking the photo or «Zoom» opens the
 * zoom dialog (`data-zoom-open`, src/scripts/model-page.ts). Without JS the
 * first frame shows and the controls stay invisible.
 */
import PhotoFrame from '../PhotoFrame.astro';
import GalleryThumbs from './GalleryThumbs.astro';
import PrintPreview from './PrintPreview.astro';
import type { Locale } from '../../i18n/locales.ts';
import { useTranslations } from '../../i18n/ui.ts';
import { PHOTO_ANGLES, type Model } from '../../data/models.ts';
import { galleryFrames } from '../../data/photos.ts';

interface Props {
  locale: Locale;
  model: Model;
}

const { locale, model } = Astro.props;
const t = useTranslations(locale);
const frames = galleryFrames(model.slug);
const first = frames[0];
---

<div class="gallery">
  <div class="thumbs-slot">
    <GalleryThumbs locale={locale} model={model} layout="column" />
  </div>
  <div class="photo">
    <div class="frames" aria-live="polite" data-zoom-open>
      {frames.map((frame) => (
        <PhotoFrame
          locale={locale}
          model={model}
          frame={frame}
          visible={frame === first}
          loading={frame === first ? 'eager' : 'lazy'}
        >
          <PrintPreview
            locale={locale}
            model={model}
            frame={frame}
            size="page"
          />
        </PhotoFrame>
      ))}
    </div>
    <span class="counter js-only" data-gallery-counter>
      {`1 / ${PHOTO_ANGLES.length}`}
    </span>
    <button
      type="button"
      class="step prev js-only"
      data-gallery-prev
      aria-label={t('photo.prev')}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M15 5l-7 7 7 7"></path>
      </svg>
    </button>
    <button
      type="button"
      class="step next js-only"
      data-gallery-next
      aria-label={t('photo.next')}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
    <button
      type="button"
      class="zoom label js-only"
      aria-haspopup="dialog"
      data-zoom-open
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <path d="M15.5 15.5L21 21M10.5 7.5v6M7.5 10.5h6"></path>
      </svg>
      <span>{t('photo.zoomButton')}</span>
    </button>
  </div>
</div>

<style>
  .gallery {
    display: flex;
    align-items: flex-start;
    gap: var(--col-gap);
    flex: 2 1 calc(64px + var(--col-gap) + 420px);
    max-width: calc(64px + var(--col-gap) + 760px);
    min-width: 0;
  }
  .thumbs-slot {
    flex: 0 0 64px;
  }
  .photo {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    aspect-ratio: 3 / 4;
    background: var(--shirt-bg);
    overflow: hidden;
  }
  /* Narrow screens: the photo full width, thumbnails in a row under it. */
  @media (max-width: 599px) {
    .gallery {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      flex-basis: 100%;
    }
    .thumbs-slot {
      flex: none;
      order: 1;
    }
    .photo {
      flex: none;
      width: 100%;
    }
  }

  :global([data-model-page]:not([data-gallery-ready])) .js-only {
    visibility: hidden;
  }
  .frames {
    position: absolute;
    inset: 0;
  }
  :global([data-zoom-ready]) .frames {
    cursor: zoom-in;
  }
  .counter {
    position: absolute;
    top: 14px;
    right: 14px;
    color: var(--shirt-muted);
    font-size: 11px;
    pointer-events: none;
  }
  .step {
    position: absolute;
    top: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    width: 30%;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .prev {
    left: 0;
    justify-content: flex-start;
    padding: 0 0 0 14px;
  }
  .next {
    right: 0;
    justify-content: flex-end;
    padding: 0 14px 0 0;
  }
  .step svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: var(--shirt-ink);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .step:focus-visible,
  .zoom:focus-visible {
    outline-color: var(--shirt-ink);
  }
  .step:focus-visible {
    outline-offset: -4px;
  }
  .zoom {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 12px;
    border: 1px solid var(--shirt-ink);
    border-radius: 0;
    background: var(--shirt-bg);
    color: var(--shirt-ink);
    cursor: zoom-in;
  }
  .zoom[hidden] {
    display: none;
  }
  /* 36px tall as in the mockup; the hit area is 44px. */
  .zoom::after {
    content: '';
    position: absolute;
    inset: -5px -1px;
  }
  .zoom svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
</style>
