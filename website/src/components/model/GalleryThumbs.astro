---
/**
 * Angle thumbnails of a model gallery (`data-gallery-thumb` buttons, see
 * src/scripts/gallery.ts). Each shows the photo for the current colour, or
 * the angle number on the shirt colour while there is no photo; the page
 * script swaps colours through `data-show-color`.
 */
import type { Locale } from '../../i18n/locales.ts';
import { useTranslations } from '../../i18n/ui.ts';
import { PHOTO_ANGLES, SHIRT_COLORS, type Model } from '../../data/models.ts';
import { productPhoto } from '../../data/photos.ts';
import { FIRST_COLOR } from './options.ts';

interface Props {
  locale: Locale;
  model: Model;
  /** column: beside the page photo (a row on narrow screens); row: zoom. */
  layout: 'column' | 'row';
}

const { locale, model, layout } = Astro.props;
const t = useTranslations(locale);

const thumbs = PHOTO_ANGLES.map((angle, index) => ({
  index,
  label: t('photo.thumb', {
    n: index + 1,
    angle: t(`angle.${angle}` as const),
  }),
  looks: SHIRT_COLORS.map(({ id }) => ({
    color: id,
    image: productPhoto(model.slug, id, angle),
  })),
}));
---

<div
  class:list={['thumbs', layout]}
  role="group"
  aria-label={t('photo.angles')}
>
  {thumbs.map(({ index, label, looks }) => (
    <button
      type="button"
      class="thumb"
      data-gallery-thumb
      data-index={index}
      aria-pressed={index === 0 ? 'true' : 'false'}
      aria-label={label}
    >
      {looks.map(({ color, image }) =>
        image ? (
          <img
            src={image.src}
            width={image.width}
            height={image.height}
            alt=""
            loading="lazy"
            decoding="async"
            data-show-color={color}
            hidden={color !== FIRST_COLOR}
          />
        ) : (
          <span
            class="number"
            aria-hidden="true"
            data-show-color={color}
            hidden={color !== FIRST_COLOR}
          >
            {index + 1}
          </span>
        ),
      )}
    </button>
  ))}
</div>

<style>
  .thumbs {
    display: flex;
    gap: 6px;
  }
  .column {
    flex-direction: column;
  }
  .row {
    justify-content: center;
  }
  @media (max-width: 599px) {
    .column {
      flex-direction: row;
    }
  }
  /* Thumbnails do nothing until the gallery script runs. */
  :global([data-model-page]:not([data-gallery-ready])) .thumbs {
    visibility: hidden;
  }

  .thumb {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 64px;
    aspect-ratio: 3 / 4;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 0;
    background: var(--shirt-bg);
    color: var(--shirt-muted);
    font-size: 11px;
    cursor: pointer;
    overflow: hidden;
  }
  .thumb[aria-pressed='true'] {
    border-color: var(--color-black);
  }
  /* The mockup's white inner ring, over the photo if there is one. Not an
     outline, so the focus outline stays free. */
  .thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .thumb[aria-pressed='true']::after {
    box-shadow: inset 0 0 0 1px var(--color-white);
  }
  .thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .thumb [hidden] {
    display: none;
  }
</style>
