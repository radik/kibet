---
/**
 * Full-screen view of the model gallery: a native modal <dialog> with its own
 * `[data-gallery]` (title and counter, close, previous / next, the large
 * photo or print preview, angle thumbnails). src/scripts/model-page.ts opens
 * it with showModal() and keeps it in step with the page gallery; Esc
 * closes it and focus returns to the opener.
 */
import PhotoFrame from '../PhotoFrame.astro';
import GalleryThumbs from './GalleryThumbs.astro';
import PrintPreview from './PrintPreview.astro';
import type { Locale } from '../../i18n/locales.ts';
import { useTranslations } from '../../i18n/ui.ts';
import { PHOTO_ANGLES, type Model } from '../../data/models.ts';
import { galleryFrames } from '../../data/photos.ts';
import { FIRST_COLOR } from './options.ts';

interface Props {
  locale: Locale;
  model: Model;
}

const { locale, model } = Astro.props;
const t = useTranslations(locale);
const frames = galleryFrames(model.slug);
const first = frames[0];
---

<dialog
  class="zoom"
  aria-label={t('photo.zoomDialog', { title: model.title })}
  data-zoom
>
  <div class="inner" data-gallery data-gallery-color={FIRST_COLOR}>
    <div class="bar label">
      <p>
        <span lang={model.titleLang}>{model.title}</span>
        <span aria-hidden="true">·</span>
        <span data-gallery-counter>{`1 / ${PHOTO_ANGLES.length}`}</span>
      </p>
      <button type="button" class="close label" data-zoom-close>
        {t('photo.close')}
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M5 5l14 14M19 5L5 19"></path>
        </svg>
      </button>
    </div>
    <div class="stage">
      <div class="viewer">
        <button
          type="button"
          class="step prev"
          data-gallery-prev
          aria-label={t('photo.prev')}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M15 5l-7 7 7 7"></path>
          </svg>
        </button>
        <div class="photo">
          {frames.map((frame) => (
            <PhotoFrame
              locale={locale}
              model={model}
              frame={frame}
              visible={frame === first}
            >
              <PrintPreview
                locale={locale}
                model={model}
                frame={frame}
                size="zoom"
              />
            </PhotoFrame>
          ))}
        </div>
        <button
          type="button"
          class="step next"
          data-gallery-next
          aria-label={t('photo.next')}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>
    </div>
    <div class="thumbs">
      <GalleryThumbs locale={locale} model={model} layout="row" />
    </div>
  </div>
</dialog>

<style>
  .zoom {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-white);
    color: var(--color-black);
    overscroll-behavior: contain;
  }
  .zoom::backdrop {
    background: var(--color-white);
  }
  /* The page behind does not scroll while the dialog is open. */
  :global(html:has(dialog[data-zoom][open])) {
    overflow: hidden;
  }
  .inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px var(--gutter);
  }
  .bar p {
    min-width: 0;
  }
  .close {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
    height: 44px;
    padding: 0 4px 0 12px;
    border: 0;
    background: none;
    color: var(--color-black);
    cursor: pointer;
  }
  .close svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .stage {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding: 0 8px 16px;
  }
  .viewer {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 100%;
  }
  .step {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 44px;
    width: 44px;
    height: 88px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .step svg {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: var(--color-black);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* 3:4 and as tall as fits; never wider than the room between the arrows
     (2 × 44px + 2 × 8px gap + 2 × 8px padding). */
  .photo {
    position: relative;
    flex: none;
    height: min(100%, 1400px, calc((100vw - 120px) * 4 / 3));
    aspect-ratio: 3 / 4;
    background: var(--shirt-bg);
    overflow: hidden;
  }

  .thumbs {
    padding: 0 16px 18px;
  }

  /* Narrow screens: the photo as wide as fits, arrows over its edges. */
  @media (max-width: 599px) {
    .stage {
      padding: 0 0 12px;
    }
    .viewer {
      position: relative;
      display: block;
      height: min(100%, calc(100vw * 4 / 3));
      aspect-ratio: 3 / 4;
    }
    .photo {
      width: 100%;
      height: 100%;
    }
    .step {
      position: absolute;
      top: 50%;
      z-index: 1;
      transform: translateY(-50%);
    }
    .prev {
      left: 0;
    }
    .next {
      right: 0;
    }
    .step svg {
      stroke: var(--shirt-ink);
    }
    .step:focus-visible {
      outline-color: var(--shirt-ink);
      outline-offset: -4px;
    }
  }
</style>
