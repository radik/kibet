---
/**
 * One gallery frame (model × colour × angle): the photo, or a labelled grey
 * placeholder while there is none (see src/data/photos.ts). Fills its
 * positioned container. Markup follows the gallery contract in
 * src/scripts/gallery.ts (`data-gallery-frame`, `data-color`, `data-index`).
 * Children, if any, replace the grey placeholder (e.g. the model page's
 * print preview); they are not rendered once the photo exists.
 */
import type { Locale } from '../i18n/locales.ts';
import { useTranslations } from '../i18n/ui.ts';
import type { Model } from '../data/models.ts';
import type { GalleryFrame } from '../data/photos.ts';

interface Props {
  locale: Locale;
  model: Model;
  frame: GalleryFrame;
  /** Visible before the gallery script runs; all other frames are hidden. */
  visible?: boolean;
  /** Image loading; 'eager' for the frame shown first above the fold. */
  loading?: 'lazy' | 'eager';
}

const { locale, model, frame } = Astro.props;
const { visible = false, loading = 'lazy' } = Astro.props;
const t = useTranslations(locale);
const angle = t(`angle.${frame.angle}` as const);
const shirt = t('photo.shirt', { color: t(`color.${frame.color}` as const) });
const image = frame.image;
const custom = Astro.slots.has('default');
---

<div
  class="frame"
  data-gallery-frame
  data-color={frame.color}
  data-index={frame.index}
  hidden={!visible}
>
  {image ? (
    <img
      src={image.src}
      width={image.width}
      height={image.height}
      alt={t('photo.alt', { title: model.title, shirt, angle })}
      loading={loading}
      decoding="async"
    />
  ) : custom ? (
    <slot />
  ) : (
    <div class="placeholder">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 8h3l2-3h6l2 3h3v11H4z" />
        <circle cx="12" cy="13" r="3.5" />
      </svg>
      <span class="caption">
        {t('photo.label', { n: frame.index + 1, angle })}
      </span>
      <span>{shirt}</span>
    </div>
  )}
</div>

<style>
  .frame {
    position: absolute;
    inset: 0;
  }
  .frame[hidden] {
    display: none;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 100%;
    padding: 16px;
    color: var(--color-grey-700);
    font-size: 11px;
    text-align: center;
  }
  svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .caption {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
</style>
