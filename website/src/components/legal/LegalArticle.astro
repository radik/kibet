---
/**
 * Long-form frame for the legal pages: <h1>, “last updated” line, the note
 * that only the German text is binding (English pages), and the reading
 * typography for the text in the default slot (h2, h3, p, ul, address).
 */
import BindingNote from './BindingNote.astro';
import { LEGAL_LAST_UPDATED } from '../../data/legal.ts';
import type { LegalPage } from '../../i18n/paths.ts';
import type { LegalLanguage } from './meta.ts';

interface Props {
  page: LegalPage;
  language: LegalLanguage;
  heading: string;
}

const { page, language, heading } = Astro.props;
const updatedLabel = language === 'de' ? 'Stand:' : 'Last updated:';
const updatedText = LEGAL_LAST_UPDATED[language];
---

<article class="legal">
  <header>
    <h1>{heading}</h1>
    <p class="updated">
      {updatedLabel}
      <time datetime={LEGAL_LAST_UPDATED.datetime}>{updatedText}</time>
    </p>
    {language === 'en' && <BindingNote page={page} />}
  </header>
  <slot />
</article>

<style>
  .legal {
    max-width: calc(70ch + 2 * var(--gutter));
    padding: clamp(32px, 5vw, 72px) var(--gutter) clamp(64px, 8vw, 120px);
    font-size: 16px;
    letter-spacing: 0;
    line-height: 1.65;
  }
  header {
    margin-bottom: 40px;
  }
  h1 {
    font-family: var(--font-display);
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.01em;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .updated {
    margin-top: 16px;
    color: var(--color-grey-700);
  }
  .legal :global(h2) {
    margin-top: 48px;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
  }
  .legal :global(h3) {
    margin-top: 32px;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.35;
  }
  .legal :global(:is(h2, h3) + *) {
    margin-top: 12px;
  }
  .legal :global(:is(p, ul, address) + :is(p, ul, address)) {
    margin-top: 16px;
  }
  .legal :global(ul) {
    padding-left: 1.25em;
  }
  .legal :global(li + li) {
    margin-top: 6px;
  }
  .legal :global(address) {
    font-style: normal;
  }
  .legal :global(a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
</style>
